local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

local BOSSES = {
    ["Rip Indra"]       = {match = "Rip_Indra",    color = Color3.fromRGB(255, 80, 0)},
    ["Katakuri V1"]     = {match = "Katakuri",     color = Color3.fromRGB(255, 150, 0)},
    ["Katakuri V2"]     = {match = "Katakuri",     color = Color3.fromRGB(200, 0, 200)},
}

local function addESP(model, displayName, color)
    if not model or model:FindFirstChild("ESP_HL") then return end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local hl = Instance.new("Highlight")
    hl.Name = "ESP_HL"
    hl.FillColor = color
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.6
    hl.Parent = model

    local bb = Instance.new("BillboardGui")
    bb.Name = "ESP_BB"
    bb.Size = UDim2.new(0, 220, 0, 60)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.AlwaysOnTop = true
    bb.Parent = hrp

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = displayName .. "\n[CLICK ĐỂ TELEPORT]"
    lbl.Parent = bb

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = bb
    btn.MouseButton1Click:Connect(function()
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if myHrp and hrp.Parent then
            myHrp.CFrame = hrp.CFrame + Vector3.new(0, 8, 0)
        end
    end)
end

task.spawn(function()
    while task.wait(2) do
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    for name, info in pairs(BOSSES) do
                        if obj.Name:find(info.match, 1, true) then
                            addESP(obj, name, info.color)
                        end
                    end
                end
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        local nearest, bestDist = nil, math.huge
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("ESP_HL") then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - myHrp.Position).Magnitude
                    if d < bestDist then bestDist = d; nearest = hrp end
                end
            end
        end
        if nearest then myHrp.CFrame = nearest.CFrame + Vector3.new(0, 8, 0) end
    end
end)

print("[BloxESP] Loaded. Nhấn F để teleport boss gần nhất.")
